Configs: {
	Config: {
		DisplayName: Einstellungen

		respawnSpectateOffToggle: {
			Tooltip: Zuschauen beenden, sobald man wiederbelebt wird
			Label: Zuschauen beenden, sobald man wiederbelebt wird
		}

		spectateOnDeath: {
			Tooltip: Nächsten Spieler automatisch zuschauen, sobald man stirbt
			Label: Nächsten Spieler automatisch zuschauen, sobald man stirbt
		}

		gridItemGap: {
			Tooltip: Ändert die Lücke zwischen Elementen im Zuschauermenü
			Label: Lückengröße
		}

		gridPadding: {
			Tooltip: Ändert den Abstand zwischen dem Menü und den Knöpfen
			Label: Menüpolsterung
		}

		gridMaxColumns: {
			Tooltip: Ändert die Spaltenanzahl im Zuschauermenü
			Label: Max. Spalten
		}

		Headers: {
			GridProperties: Gittereigenschaften
			QoL: Verhalten
		}

		animationVelocity: {
			Label: Animationsgeschwindigkeit
			Tooltip: Ändert wie schnell animationen abspielen
		}
	}
}
