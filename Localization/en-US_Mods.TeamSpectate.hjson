Keybinds: {
	PreviousPlayer.DisplayName: Spectate previous player
	NextPlayer.DisplayName: Spectate next player
	Stop.DisplayName: Stop spectating
}

PlayerDead: Player is dead
PlayerDifferentTeam: Player is on a different party than you
PlayerNotFound: Player is hidden or doesn't exist
BossHeadIndexNotFound: Boss is hidden or doesn't exist
BossTooltip: Boss
YouTooltip: You
Filter: Filter
FilterEverythingTooltip: All
FilterPlayersTooltip: Players
FilterBossesTooltip: Bosses

Configs: {
	Config: {
		DisplayName: Config

		respawnSpectateOffToggle: {
			Tooltip: Exit spectate mode upon respawn
			Label: Exit spectate mode upon respawn
		}

		spectateOnDeath: {
			Tooltip: Spectate the nearest player upon death
			Label: Spectate the nearest player upon death
		}

		gridItemGap: {
			Tooltip: Modifies gap between items in spectate menu
			Label: Items gap
		}

		gridPadding: {
			Tooltip: Modifies spectate menu padding value
			Label: Menu padding
		}

		gridMaxColumns: {
			Tooltip: Modifies columns limit in spectate menu
			Label: Max columns
		}

		Headers: {
			GridProperties: Grid Properties
			QoL: Quality of Life
		}

		animationVelocity: {
			Label: Animation velocity
			Tooltip: How fast animations play
		}
	}
}
